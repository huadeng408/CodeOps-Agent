# Generated evaluation trees and review intermediates. Stable inputs and
# canonical evidence belong under data/eval; run directories stay local.
/eval_results/
/data/reports/
/data/eval/techdocs/reports/

# Downloaded audio payloads are reproducible run inputs, not repository
# fixtures.  Keep the pinned source manifest under data/eval/multimodal/audio.
/data/eval/multimodal/audio/**/*.wav
/data/eval/multimodal/audio/**/source/

# Human-review source records and canonical qrels are stable audit inputs.
# Only the local portal helper and rendered worksheet are generated scratch.
/data/eval/techdocs/review/disputed-worksheet.jsonl
/data/eval/techdocs/review/disputed-worksheet.md
/data/eval/techdocs/reviews/beeapi-openai-relay-recovery-20260813-01/_apply_review.py
/data/eval/techdocs/reviews/beeapi-openai-relay-recovery-20260813-01/human-review-worksheet.md
# Row-level review projections stay local until their provenance and verdict
# reconciliation are explicitly approved.  Force-add only an audited release
# input after that review; ordinary repository staging must not include them.
/data/eval/techdocs/reviews/beeapi-openai-relay-recovery-20260813-01/_human_review_batches/
/data/eval/techdocs/reviews/beeapi-openai-relay-recovery-20260813-01/*.merged.jsonl

