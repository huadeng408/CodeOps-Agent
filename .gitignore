# Repository clones and per-run scratch created by the SWE-bench harness.
# These are checkouts of upstream projects (astropy alone is 91MB), reproducible
# from the instance's base_commit, so they are artifacts and never source.
eval/swebench_work/astropy/
eval/swebench_work/agent_run/
eval/swebench_work/repos/
eval/swebench_work/h5_rescore/
# Docker layer extracts pulled for inspection (31MB of upstream image content).
docker-extracts/
.mnm/
# Official scorer run summaries land in the harness CWD (repo root).  The
# authoritative copy now lives under each run's artifact tree via
# RunArtifacts.record_scorer_output(), where checksums.sha256 pins it.
/deepseek-*.json
eval/*.ckpt
eval/*_output.txt
eval/eval_final_*_batch*.json
eval/samples_*.ckpt
eval/checkpoint_*.json
eval/results_*.jsonl
eval/*Plus-v*.jsonl
eval/eval_results_*.json
eval/eval_results_*.jsonl
eval/samples_*_eval_results.json
eval/samples_*_filtered.jsonl
eval/*.ckpt.edge_cases.json
eval/swebench_flask5014.json
results/
# Stray eval intermediates written to repo root
/eval_checkpoint_*.json
/eval_results_*.jsonl
/eval_results_*.json
