# Official SWE-bench scorer output written relative to its working directory.
# Regenerable per run and keyed by a per-process run_id, so it would otherwise
# accumulate one file per instance per run in the repository root.
code-agent-*.swebench-*.json
# Native Windows scorer reports are also reproducible run artifacts.
code-agent-*.native-*.json

# Local runtime, dependency caches and generated process state.  These paths
# are reproducible or machine-specific and must never enter the repository.
.runtime/
.tmp/
.playwright-mcp/
internal/cli/.agent/
*.pid
*.prof
*.coverage
/.tmp-native-test.log
/$taskDiag

