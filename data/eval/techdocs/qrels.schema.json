{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechDocs qrels record",
  "description": "One graded relevance judgement for a retrieval query against a stable document/section. qrels must reference stable document_id/section_path only; volatile chunk/page/element ordinals and answer text are rejected. Language is zh or en; reviewer_hash is a redacted reviewer identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "document_id",
    "section_path",
    "relevance",
    "source_id",
    "language",
    "query_type"
  ],
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "section_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "relevance": {
      "type": "integer",
      "minimum": 0
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": ["zh", "en"]
    },
    "query_type": {
      "type": "string",
      "minLength": 1
    },
    "evidence_type": {
      "type": "string",
      "enum": ["text", "image", "table", "equation", "layout", "multi-page"]
    },
    "reviewer_hash": {
      "type": "string",
      "description": "Redacted reviewer identifier (16 hex chars). Empty string means the row is not yet reviewed.",
      "pattern": "^(|[0-9a-f]{16})$"
    }
  }
}
