OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=https://beecode.cc
OPENAI_MODEL=gpt-4o

# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=local

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# PDF Read uses MinerU in OCR mode. Override this only when the executable is
# installed under a different command or absolute path.
# CODE_AGENT_MINERU_COMMAND=mineru
# CODE_AGENT_MINERU_BACKEND=pipeline

# OpenTelemetry — when set, Go + Python emit trace spans to a local or remote collector.
# Phoenix:   python -m phoenix.server.main serve --port 6006 --host 127.0.0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
