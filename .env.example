OPENAI_API_KEY=<your-openai-api-key>
OPENAI_BASE_URL=https://beecode.cc
OPENAI_MODEL=gpt-4o

# Required by docker compose; choose local-only values and keep this file
# unmodified in source control.
# MYSQL_ROOT_PASSWORD=
# MYSQL_PASSWORD=
# REDIS_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=

# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=local

# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Python context persistence. SQLite is the default; selecting a remote
# backend is explicit and fails closed when its service or dependency is absent.
# CODE_AGENT_CONTEXT_BACKEND=sqlite
# CODE_AGENT_CONTEXT_REDIS_URL=redis://127.0.0.1:6379/0
# CODE_AGENT_CONTEXT_MYSQL_DSN=mysql://codeagent@127.0.0.1:3306/codeagent

# All PDF entry points use MinerU in OCR mode. Tika remains available only for
# non-PDF documents such as DOCX, PPTX, and XLSX.
# CODE_AGENT_MINERU_COMMAND=mineru
# CODE_AGENT_MINERU_BACKEND=pipeline
# CODE_AGENT_MINERU_TIMEOUT_SECONDS=600

# Corpus names and alias switching are configured in configs/server.yaml.
# Alias switching remains disabled until the retrieval cutover is verified.

# Configure RAG search and ingestion through environment variables. The internal
# token is read only from CODE_AGENT_RAG_INTERNAL_SECRET and must never be put
# in settings JSON, dotenv files, fixtures, logs, or committed artifacts.
# CODE_AGENT_RAG_SERVER_URL=http://127.0.0.1:8081
# CODE_AGENT_RAG_INTERNAL_SECRET=<local-secret>
# CODE_AGENT_RAG_USER_ID=1

# OpenTelemetry — when set, Go + Python emit trace spans to a local or remote collector.
# Phoenix:   python -m phoenix.server.main serve --port 6006 --host 127.0.0.1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:6006/v1/traces
